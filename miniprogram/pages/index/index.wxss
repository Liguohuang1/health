.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.icon-brain {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6b7280;
}

.features {
  margin-top: 40rpx;
}

.feature-item {
  font-size: 28rpx;
  color: #374151;
  margin: 15rpx 0;
  padding-left: 20rpx;
}

.stats-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #2563eb;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
}

.preview-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 30rpx;
  text-align: center;
}

.preview-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.preview-item {
  width: 45%;
  text-align: center;
  margin-bottom: 30rpx;
}

.preview-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin: 0 auto 15rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #374151;
}

.disclaimer {
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 15rpx;
  padding: 30rpx;
  margin: 40rpx 0;
  font-size: 24rpx;
  color: #dc2626;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}
